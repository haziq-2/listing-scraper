# AutoWatch environment variables (copy to .env and adjust)

# Logging
AUTOWATCH_LOG_LEVEL=INFO

# Database
AUTOWATCH_DB_PATH=data/vehicles.db
AUTOWATCH_DATABASE_BACKEND=sqlite

# Region defaults
AUTOWATCH_SEARCH_RADIUS_KM=80

# Craigslist
AUTOWATCH_CRAIGSLIST_MAX_LISTINGS=350
AUTOWATCH_CRAIGSLIST_FETCH_DETAILS=false

# Facebook Marketplace
AUTOWATCH_FACEBOOK_ENABLED=true
AUTOWATCH_FACEBOOK_HEADLESS=false
AUTOWATCH_FACEBOOK_PROFILE_DIR=data/fb_profile
# Use installed Google Chrome (recommended for login persistence). Set empty for bundled Chromium.
AUTOWATCH_FACEBOOK_BROWSER_CHANNEL=chrome
AUTOWATCH_FACEBOOK_MAX_LISTINGS=100
AUTOWATCH_FACEBOOK_MAX_SCROLLS=25
AUTOWATCH_FACEBOOK_SCROLL_STALL_ATTEMPTS=3
AUTOWATCH_FACEBOOK_SCROLL_WAIT_MS=2500
AUTOWATCH_FACEBOOK_AUTH_TIMEOUT_SECONDS=300

# Retries
AUTOWATCH_RETRY_ATTEMPTS=4
AUTOWATCH_RETRY_BACKOFF_BASE=2.0
AUTOWATCH_RETRY_BACKOFF_MAX=30.0

# Optional: Facebook credentials are NOT used for automated login.
# Sign in once interactively with AUTOWATCH_FACEBOOK_HEADLESS=false.
# Never commit real credentials.
